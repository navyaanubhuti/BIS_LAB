import math
import random
import numpy as np


def fitness(x):
    return np.sum(x**2)


N = 30
iterations = 50
pa = 0.25

nests = np.random.uniform(-10, 10, (N, 2))


def levy_flight():
    beta = 1.5
    sigma = (
        math.gamma(1 + beta)
        * np.sin(np.pi * beta / 2)
        / (math.gamma((1 + beta) / 2) * beta * 2 ** ((beta - 1) / 2))
    ) ** (1 / beta)
    u = np.random.normal(0, sigma, 2)
    v = np.random.normal(0, 1, 2)
    return u / (np.abs(v) ** (1 / beta) + 1e-10)


for i in range(iterations):
    for j in range(N):
        new = nests[j] + 0.01 * levy_flight()
        new = np.clip(new, -10, 10)
        k = random.randrange(N)
        if fitness(new) < fitness(nests[k]):
            nests[k] = new

    for j in range(N):
        if random.random() < pa:
            nests[j] = np.random.uniform(-10, 10, 2)

best = min(nests, key=fitness)
print("Best Solution:", best)
print("Minimum Value:", fitness(best))
